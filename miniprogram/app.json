{
  "pages": [
    "pages/dashboard/index",
    "pages/transactions/index",
    "pages/planning/index",
    "pages/profile/index",
    "pages/index/index",
    "pages/users/users",
    "pages/users/contributions/contributions",
    "pages/users/about/about"
  ],
  "window": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "ChiLeMe",
    "navigationBarBackgroundColor": "#ffffff",
    "enablePullDownRefresh": true,
    "backgroundColor": "#F6F6F6",
    "backgroundTextStyle": "light"
  },
  "tabBar": {
    "color": "#999999",
    "selectedColor": "#1890FF",
    "backgroundColor": "#ffffff",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/dashboard/index",
        "text": "总览",
        "iconPath": "pages/assets/mutemic.png",
        "selectedIconPath": "pages/assets/redmic.png"
      },
      {
        "pagePath": "pages/planning/index",
        "text": "资产",
        "iconPath": "pages/assets/calendar_muted.png",
        "selectedIconPath": "pages/assets/calendar_active.png"
      },
      {
        "pagePath": "pages/transactions/index",
        "text": "明细",
        "iconPath": "pages/assets/report.png",
        "selectedIconPath": "pages/assets/ic_mall_active.png"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "我的",
        "iconPath": "pages/assets/ic_user.png",
        "selectedIconPath": "pages/assets/ic_user_active.png"
      }
    ]
  },

  "useExtendedLib": {
    "weui": true
  },

  "usingComponents": {
    "mp-navigation-bar": "weui-miniprogram/navigation-bar/navigation-bar",
    "toolbar": "/colorui/components/toolbar"
  },

  "lazyCodeLoading": "requiredComponents"
}