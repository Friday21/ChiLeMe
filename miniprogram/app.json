{
  "pages": [
    "pages/timeOverview/index",
    "pages/timeCategory/index",
    "pages/timeSites/index",
    "pages/profile/index",
    "pages/dashboard/index",
    "pages/transactions/index",
    "pages/assetsManage/index",
    "pages/index/index",
    "pages/users/users",
    "pages/users/contributions/contributions",
    "pages/users/about/about"
  ],
  "window": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "一日虚度",
    "navigationBarBackgroundColor": "#ffffff",
    "enablePullDownRefresh": true,
    "backgroundColor": "#F6F6F6",
    "backgroundTextStyle": "light"
  },
  "tabBar": {
    "color": "#999999",
    "selectedColor": "#1890FF",
    "backgroundColor": "#ffffff",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/timeOverview/index",
        "text": "时间",
        "iconPath": "pages/assets/money.png",
        "selectedIconPath": "pages/assets/money_active.png"
      },
      {
        "pagePath": "pages/timeCategory/index",
        "text": "分类",
        "iconPath": "pages/assets/ic_board.png",
        "selectedIconPath": "pages/assets/ic_board_active.png"
      },
      {
        "pagePath": "pages/timeSites/index",
        "text": "记录",
        "iconPath": "pages/assets/report.png",
        "selectedIconPath": "pages/assets/report_active.png"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "我的",
        "iconPath": "pages/assets/ic_user.png",
        "selectedIconPath": "pages/assets/ic_user_active.png"
      }
    ]
  },

  "useExtendedLib": {
    "weui": true
  },

  "usingComponents": {
    "mp-navigation-bar": "weui-miniprogram/navigation-bar/navigation-bar",
    "toolbar": "/colorui/components/toolbar"
  },

  "lazyCodeLoading": "requiredComponents"
}