.date-strip {
  background: #ffffff;
  padding: 20rpx 32rpx 18rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #f0f0f0;
}

.date-center {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  justify-content: center;
}

.date-label {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.date-caret {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.arrow-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #4B7BF5;
  font-weight: 300;
  border-radius: 50%;
  background: rgba(75, 123, 245, 0.08);
}

.arrow-disabled {
  color: #ccc;
  background: transparent;
}

.date-left, .date-right {
  flex-shrink: 0;
}

.today-badge {
  margin-left: 12rpx;
  background: rgba(75, 123, 245, 0.1);
  color: #4B7BF5;
  border-radius: 40rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}
