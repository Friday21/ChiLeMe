<view class="page-wrap">

  <!-- 顶部标题区 -->
  <view class="page-header">
    <view class="page-title">7 天趋势</view>
    <view class="page-sub">{{rangeLabel}}</view>
  </view>

  <!-- 加载 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="shine-grey" style="height:520rpx;margin:24rpx;border-radius:24rpx;display:block;"></view>
    <view class="shine-grey" style="height:160rpx;margin:16rpx 24rpx;border-radius:20rpx;display:block;"></view>
    <view class="shine-grey" style="height:160rpx;margin:16rpx 24rpx;border-radius:20rpx;display:block;"></view>
  </view>

  <!-- 无数据 -->
  <view class="empty-wrap" wx:elif="{{!loading && !hasData}}">
    <view class="empty-icon">📈</view>
    <view class="empty-text">最近 7 天还没有数据</view>
  </view>

  <!-- 有数据 -->
  <block wx:elif="{{!loading && hasData}}">

    <!-- 图例（可点击筛选） -->
    <view class="legend-row">
      <view
        class="legend-chip {{activeCat === item.key ? 'legend-chip-active' : ''}} {{activeCat && activeCat !== item.key ? 'legend-chip-dim' : ''}}"
        wx:for="{{summaries}}"
        wx:key="key"
        bindtap="onLegendTap"
        data-key="{{item.key}}"
        style="{{activeCat === item.key ? 'background:' + item.color + ';color:#fff;border-color:' + item.color : 'border-color:' + item.color}}"
      >
        <view class="legend-dot" style="background:{{item.color}}" wx:if="{{activeCat !== item.key}}"></view>
        <text class="legend-name">{{item.key}}</text>
      </view>
    </view>

    <!-- 曲线图 -->
    <view class="chart-card">
      <canvas
        canvas-id="trendCanvas"
        id="trendCanvas"
        class="chart-canvas"
      ></canvas>
    </view>

    <!-- 摘要 -->
    <view class="summary-list">
      <view
        class="summary-card {{activeCat && activeCat !== item.key ? 'summary-dim' : ''}}"
        wx:for="{{summaries}}"
        wx:key="key"
      >
        <view class="sc-head">
          <view class="sc-icon-wrap" style="background:{{item.bgLight}}">
            <image class="sc-icon-img" src="{{item.icon}}" mode="aspectFit" wx:if="{{item.icon}}"></image>
            <text class="sc-emoji" wx:else>{{item.emoji}}</text>
          </view>
          <view class="sc-title-wrap">
            <view class="sc-name">{{item.key}}</view>
            <view class="sc-sub">7 天共 {{item.totalLabel}}</view>
          </view>
          <view class="sc-trend sc-trend-{{item.trend}}">
            <text class="sc-trend-arrow" wx:if="{{item.trend === 'up'}}">↑</text>
            <text class="sc-trend-arrow" wx:if="{{item.trend === 'down'}}">↓</text>
            <text class="sc-trend-arrow" wx:if="{{item.trend === 'flat'}}">—</text>
            <text class="sc-trend-val">{{item.trend === 'flat' ? '持平' : item.diffAbs}}</text>
          </view>
        </view>
        <view class="sc-stats">
          <view class="sc-stat">
            <view class="sc-stat-val">{{item.lastLabel}}</view>
            <view class="sc-stat-key">今天</view>
          </view>
          <view class="sc-stat-divider"></view>
          <view class="sc-stat">
            <view class="sc-stat-val">{{item.avgLabel}}</view>
            <view class="sc-stat-key">日均</view>
          </view>
          <view class="sc-stat-divider"></view>
          <view class="sc-stat">
            <view class="sc-stat-val">{{item.maxLabel}}</view>
            <view class="sc-stat-key">最多</view>
          </view>
        </view>
      </view>
    </view>

    <view style="height:40rpx"></view>
  </block>

</view>
