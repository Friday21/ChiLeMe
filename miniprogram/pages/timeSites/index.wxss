.page-wrap {
  min-height: 100vh;
  background: #f5f5f8;
  padding-bottom: 40rpx;
}

/* ── Header ── */
.page-header {
  padding: 32rpx 32rpx 16rpx;
}
.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
  letter-spacing: -0.5rpx;
}
.page-sub {
  font-size: 24rpx;
  color: #9aa3b2;
  margin-top: 6rpx;
  letter-spacing: 0.5rpx;
}

/* ── Loading/empty ── */
.loading-wrap { padding-top: 16rpx; }

.empty-wrap {
  min-height: 55vh;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  gap: 20rpx; padding: 120rpx 40rpx;
}
.empty-icon { font-size: 100rpx; }
.empty-text {
  font-size: 28rpx;
  color: #bbb;
  text-align: center;
  line-height: 1.8;
  white-space: pre-wrap;
}

/* ── Legend ── */
.legend-row {
  display: flex;
  gap: 12rpx;
  padding: 0 24rpx 16rpx;
  overflow-x: auto;
}
.legend-row::-webkit-scrollbar { display: none; }

.legend-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  padding: 10rpx 22rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 600;
  background: #fff;
  border: 1rpx solid;
  color: #555;
  transition: all 0.18s ease;
}
.legend-chip-active {
  box-shadow: 0 6rpx 14rpx rgba(0,0,0,0.08);
  transform: translateY(-1rpx);
}
.legend-chip-dim {
  opacity: 0.45;
}
.legend-dot {
  width: 14rpx; height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.legend-name {
  letter-spacing: 0.5rpx;
}

/* ── Chart ── */
.chart-card {
  margin: 0 24rpx 20rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 16rpx 10rpx 8rpx;
  box-shadow: 0 4rpx 20rpx rgba(30, 41, 59, 0.04);
}
.chart-canvas {
  width: 100%;
  height: 480rpx;
  display: block;
}

/* ── Summary cards ── */
.summary-list {
  padding: 0 24rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.summary-card {
  background: #fff;
  border-radius: 22rpx;
  padding: 22rpx 24rpx 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(30, 41, 59, 0.03);
  transition: opacity 0.2s ease;
}
.summary-dim { opacity: 0.4; }

.sc-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
}
.sc-icon-wrap {
  width: 64rpx; height: 64rpx;
  border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.sc-icon-img { width: 40rpx; height: 40rpx; }
.sc-emoji { font-size: 32rpx; }

.sc-title-wrap { flex: 1; min-width: 0; }
.sc-name { font-size: 30rpx; font-weight: 700; color: #1a1a1a; }
.sc-sub { font-size: 22rpx; color: #9aa3b2; margin-top: 4rpx; }

.sc-trend {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 14rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.sc-trend-up   { color: #ef4444; background: #fef2f2; }
.sc-trend-down { color: #10b981; background: #ecfdf5; }
.sc-trend-flat { color: #9aa3b2; background: #f3f4f6; }

.sc-trend-arrow { font-size: 22rpx; }
.sc-trend-val { font-size: 22rpx; letter-spacing: 0.3rpx; }

.sc-stats {
  display: flex;
  background: #f7f8fc;
  border-radius: 16rpx;
  padding: 18rpx 0;
}
.sc-stat {
  flex: 1;
  text-align: center;
}
.sc-stat-val {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a1a1a;
  letter-spacing: -0.3rpx;
}
.sc-stat-key {
  font-size: 20rpx;
  color: #9aa3b2;
  margin-top: 4rpx;
}
.sc-stat-divider {
  width: 1rpx;
  background: #e5e7eb;
  margin: 4rpx 0;
}
