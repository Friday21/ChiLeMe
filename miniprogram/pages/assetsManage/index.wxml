<wxs module="utils">
  function getPickerDisplay(options, range, value) {
    if (!options || !range || !value) return '请选择';
    var index = range.indexOf(value);
    if (index > -1) {
      return options[index];
    }
    return '请选择';
  }
  function formatFixedDate(date) {
    if (typeof date === 'number') {
      return '每月 ' + date + ' 日';
    }
    return date;
  }
  module.exports.getPickerDisplay = getPickerDisplay;
  module.exports.formatFixedDate = formatFixedDate;
</wxs>
<view class="bg-gray-50 min-h-screen w-full">
  <van-tabs active="{{ activeTab }}" bind:change="onChangeTab" sticky>
    <!-- Assets List -->
    <van-tab title="我的资产">
      <view class="p-4">
        <block wx:for="{{ assets }}" wx:key="id">
          <view class="bg-white rounded-lg shadow-sm mb-3 p-4 flex justify-between items-center" bindtap="editAsset" data-item="{{item}}">
            <view class="flex items-center">
              <view class="w-10 h-10 rounded-full bg-blue-50 flex items-center justify-center mr-3 text-xl">
                {{ item.type === 'cash' ? '💰' : (item.type === 'stock' ? '📈' : '🏠') }}
              </view>
              <view>
                <view class="font-bold text-gray-800">{{ item.name }}</view>
                <view class="text-xs text-gray-500 mt-1" wx:if="{{ item.desc }}">{{ item.desc }}</view>
              </view>
            </view>
            <view class="font-bold text-lg">{{ item.value }}</view>
          </view>
        </block>
      </view>
    </van-tab>

    <!-- Fixed Expenses -->
    <van-tab title="固定收支">
      <view class="p-4">
        <block wx:for="{{ fixed }}" wx:key="id">
          <view class="bg-white rounded-lg shadow-sm mb-4 overflow-hidden" bindtap="editFixedItem" data-item="{{item}}">
            <view class="p-3 {{ item.type === 'income' ? 'bg-blue-50 border-blue-100' : 'bg-orange-50 border-orange-100' }} border-b flex justify-between items-center">
              <view class="font-bold {{ item.type === 'income' ? 'text-blue-800' : 'text-orange-800' }}">{{ item.name }} ({{ item.type === 'income' ? '收入' : '支出' }})</view>
            </view>
            <view class="p-4">
              <view class="flex justify-between mb-2">
                <view class="text-gray-500">金额</view>
                <view class="font-bold {{ item.type === 'income' ? 'text-green-600' : 'text-red-600' }}">{{ item.amount }}</view>
              </view>
              <view class="flex justify-between mb-2">
                <view class="text-gray-500">日期</view>
                <view>{{ utils.formatFixedDate(item.date_value) }}</view>
              </view>
              <view class="flex justify-between">
                <view class="text-gray-500">账户</view>
                <view>{{ item.account }}</view>
              </view>
            </view>
          </view>
        </block>
      </view>
    </van-tab>

    <!-- Future Income -->
    <van-tab title="未来收入">
      <view class="p-4">
        <block wx:for="{{ steps }}" wx:key="index">
          <view class="bg-white rounded-lg shadow-sm mb-3 p-4 flex justify-between items-center" bindtap="editFutureItem" data-item="{{item}}">
            <view class="flex items-center">
              <view class="w-10 h-10 rounded-full bg-purple-50 flex items-center justify-center mr-3 text-xl">
                {{ item.type === 'stock' ? '📈' : '💰' }}
              </view>
              <view>
                <view class="font-bold text-gray-800">{{ item.name }}</view>
                <view class="text-xs text-gray-500 mt-1" wx:if="{{ item.desc }}">{{ item.desc }}</view>
              </view>
            </view>
            <view class="font-bold text-lg text-purple-600">{{ item.amount || '待定' }}</view>
          </view>
        </block>
      </view>
    </van-tab>

    <!-- Mortgage Plan -->
    <van-tab title="房贷计划">
      <view class="p-4">
        <block wx:for="{{ loans }}" wx:key="id">
          <view class="bg-white rounded-lg shadow-sm mb-4 p-4" bindtap="editLoan" data-item="{{item}}">
            <view class="flex justify-between items-center mb-3 border-b border-gray-100 pb-2">
              <view class="font-bold text-gray-800">{{ item.name }}</view>
              <van-tag type="{{ item.method === 'equal_principal_interest' ? 'primary' : 'success' }}" plain size="medium">{{ item.method === 'equal_principal_interest' ? '等额本息' : '等额本金' }}</van-tag>
            </view>
            <view class="grid grid-cols-2 gap-4">
              <view>
                <view class="text-xs text-gray-500">剩余本金</view>
                <view class="font-bold text-lg">{{ item.principal }}</view>
              </view>
              <view>
                <view class="text-xs text-gray-500">剩余期数</view>
                <view class="font-bold text-lg">{{ item.periods }}</view>
              </view>
              <view>
                <view class="text-xs text-gray-500">年利率</view>
                <view class="font-bold">{{ item.rate }}%</view>
              </view>
              <view>
                <view class="text-xs text-gray-500">还款日</view>
                <view class="font-bold">{{ item.repayment_date }}</view>
              </view>
            </view>
          </view>
        </block>
      </view>
    </van-tab>
  </van-tabs>

  <!-- Floating Action Button -->
  <view class="fixed bottom-10 right-6 z-50">
    <view class="w-14 h-14 rounded-full shadow-lg flex items-center justify-center text-white active:opacity-80 transition-opacity" style="background-color: #6366f1;" bindtap="onAddClick">
      <van-icon name="plus" size="28px" />
    </view>
  </view>

  <!-- Edit Popup -->
  <van-popup show="{{ showEditPopup }}" position="bottom" round custom-style="height: 60%;" bind:close="onCloseEditPopup">
    <view class="p-4">
      <view class="text-center font-bold text-lg mb-4">{{ editTitle }}</view>
      <van-cell-group>
        <block wx:for="{{ editFields }}" wx:key="key">
          <view wx:if="{{ item.inputType === 'radio' }}" class="p-3 bg-white border-b border-gray-100">
             <view class="text-sm text-gray-500 mb-2">{{item.label}}</view>
             <van-radio-group value="{{ item.value }}" direction="horizontal" data-key="{{ item.key }}" bind:change="onEditFieldChange">
               <van-radio wx:for="{{ item.options }}" wx:for-item="option" wx:key="value" name="{{ option.value }}" custom-class="mr-4">{{ option.label }}</van-radio>
             </van-radio-group>
          </view>
          <van-cell 
            wx:elif="{{ item.inputType === 'picker' }}"
            title="{{ item.label }}"
            value="{{ utils.getPickerDisplay(item.options, item.range, item.value) }}"
            is-link
            data-key="{{ item.key }}"
            bind:click="onPickerShow"
          />
          <van-cell 
            wx:elif="{{ item.inputType === 'date-picker' }}"
            title="{{ item.label }}"
            value="{{ item.value || '请选择' }}"
            is-link
            data-frequency="{{ item.frequency }}"
            bind:click="onDatePickerShow"
          />
          <van-cell 
            wx:elif="{{ item.inputType === 'account-picker' }}"
            title="{{ item.label }}"
            value="{{ item.value || '请选择' }}"
            is-link
            bind:click="onAccountPickerShow"
          />
          <van-cell 
            wx:elif="{{ item.inputType === 'calendar' }}"
            title="{{ item.label }}"
            value="{{ item.value || '请选择' }}"
            is-link
            bind:click="onCalendarShow"
          />
          <van-field
            wx:else
            label="{{ item.label }}"
            value="{{ item.value }}"
            placeholder="{{ item.placeholder }}"
            data-key="{{ item.key }}"
            bind:change="onEditFieldChange"
          />
        </block>
      </van-cell-group>
      <view class="mt-8 px-4 flex space-x-4">
        <van-button wx:if="{{ isEditMode }}" type="danger" block round bind:click="deleteItem" custom-class="flex-1 mr-2">删除</van-button>
        <van-button type="info" block round bind:click="submitEdit" custom-class="flex-1">保存</van-button>
      </view>
    </view>
  </van-popup>

  <!-- Frequency Picker (Reused as Generic Picker) -->
  <van-popup show="{{ showFrequencyPicker }}" position="bottom" round bind:close="onFrequencyPickerCancel" z-index="200">
    <van-picker
      show-toolbar
      columns="{{ frequencyColumns }}"
      bind:confirm="onPickerConfirm"
      bind:cancel="onFrequencyPickerCancel"
    />
  </van-popup>

  <!-- Date Picker -->
  <van-popup show="{{ showDatePicker }}" position="bottom" round bind:close="onDatePickerCancel" z-index="200">
    <van-picker
      show-toolbar
      columns="{{ dateColumns }}"
      bind:confirm="onDatePickerConfirm"
      bind:cancel="onDatePickerCancel"
    />
  </van-popup>

  <!-- Account Picker -->
  <van-popup show="{{ showAccountPicker }}" position="bottom" round bind:close="onAccountPickerCancel" z-index="200">
    <van-picker
      show-toolbar
      columns="{{ accountColumns }}"
      bind:confirm="onAccountPickerConfirm"
      bind:cancel="onAccountPickerCancel"
    />
  </van-popup>

  <!-- Calendar -->
  <van-calendar show="{{ showCalendar }}" bind:close="onCalendarClose" bind:confirm="onCalendarConfirm" z-index="200" />
</view>