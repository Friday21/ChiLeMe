<!--pages/users/about/about.wxml-->
<view class="about-page">
  <!-- Hero -->
  <view class="hero">
    <view class="logo-circle">
      <text class="logo-emoji">⏱</text>
    </view>
    <view class="app-name">一日虚度</view>
    <view class="app-tagline">时间，值得被看见</view>
    <view class="version-pill">v1.0.0</view>
  </view>

  <!-- Intro -->
  <view class="card">
    <view class="card-title">这是什么</view>
    <view class="card-body">
      一款记录并可视化你每天上网时间的小工具。把浏览记录按分类聚合成清晰的图表，让你真正看清"一天的时间都花在哪儿"。
    </view>
  </view>

  <!-- Features -->
  <view class="card">
    <view class="card-title">主要功能</view>
    <view class="feature-list">
      <view class="feature-row">
        <view class="f-icon" style="background:#EBF0FF">
          <image src="/pages/assets/categories/work.svg" class="f-icon-img" mode="aspectFit"/>
        </view>
        <view class="f-text">
          <view class="f-name">时间总览</view>
          <view class="f-desc">每日时长、趋势、AI 洞察一眼看完</view>
        </view>
      </view>
      <view class="feature-row">
        <view class="f-icon" style="background:#FFF4DB">
          <image src="/pages/assets/categories/tools.svg" class="f-icon-img" mode="aspectFit"/>
        </view>
        <view class="f-text">
          <view class="f-name">分类视图</view>
          <view class="f-desc">环形图展示工作/学习/娱乐等分类占比</view>
        </view>
      </view>
      <view class="feature-row">
        <view class="f-icon" style="background:#FFF8EB">
          <image src="/pages/assets/categories/news.svg" class="f-icon-img" mode="aspectFit"/>
        </view>
        <view class="f-text">
          <view class="f-name">网站明细</view>
          <view class="f-desc">按分类分组，逐站看停留与访问次数</view>
        </view>
      </view>
      <view class="feature-row">
        <view class="f-icon" style="background:#F1F5F9">
          <image src="/pages/assets/categories/other.svg" class="f-icon-img" mode="aspectFit"/>
        </view>
        <view class="f-text">
          <view class="f-name">本地优先</view>
          <view class="f-desc">由本机定时任务汇总后再上报，无需插件常驻</view>
        </view>
      </view>
    </view>
  </view>

  <!-- Quote -->
  <view class="card quote-card">
    <view class="quote-mark">"</view>
    <view class="quote-text">你在哪里花时间，你就会成为什么样的人</view>
  </view>

  <view class="footer">
    <text>© 2026 一日虚度 · Made with ♥</text>
  </view>
</view>
