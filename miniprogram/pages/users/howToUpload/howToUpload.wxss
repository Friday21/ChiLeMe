.page {
  min-height: 100vh;
  background: #f6f7fb;
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}

/* ===== intro block ===== */
.intro {
  background: linear-gradient(135deg, #4b7bf5 0%, #6366f1 100%);
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(75, 123, 245, 0.25);
}

.intro-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 14rpx;
  letter-spacing: 1rpx;
}

.intro-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.92);
  line-height: 1.6;
  margin-bottom: 10rpx;
}

.intro-text:last-child {
  margin-bottom: 0;
}

.intro-mark {
  display: inline-block;
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #fff;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  margin: 0 4rpx;
}

/* ===== repo reference card ===== */
.repo-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #0f172a;
  border-radius: 14rpx;
  padding: 22rpx 24rpx;
}

.repo-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  background: #1e293b;
  color: #e2e8f0;
  font-size: 36rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.repo-body {
  flex: 1;
  min-width: 0;
}

.repo-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #f8fafc;
  margin-bottom: 4rpx;
  letter-spacing: 0.3rpx;
}

.repo-url {
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  font-size: 22rpx;
  color: #94a3b8;
  word-break: break-all;
  line-height: 1.4;
}

.repo-action {
  font-size: 22rpx;
  color: #0f172a;
  background: #22d3ee;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.section {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 8rpx;
  letter-spacing: 0.5rpx;
}

.section-sub {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

/* ===== openId / sample code card ===== */
.code-card {
  position: relative;
  background: #f8fafc;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
  padding: 22rpx 100rpx 22rpx 22rpx;
  display: flex;
  align-items: center;
  min-height: 76rpx;
}

.code-text {
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  font-size: 26rpx;
  color: #111827;
  word-break: break-all;
  line-height: 1.5;
  flex: 1;
}

.copy-btn {
  position: absolute;
  right: 14rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 22rpx;
  color: #fff;
  background: #4b7bf5;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
  font-weight: 500;
}

/* ===== API card (POST url) ===== */
.api-card {
  position: relative;
  background: #0f172a;
  border-radius: 14rpx;
  padding: 22rpx 100rpx 22rpx 22rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.api-method {
  display: inline-block;
  align-self: flex-start;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #0f172a;
  background: #22d3ee;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

.api-url {
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  font-size: 24rpx;
  color: #e2e8f0;
  word-break: break-all;
  line-height: 1.5;
}

/* ===== kv rows (API info) ===== */
.kv-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f1f3f7;
}

.kv-row:last-child {
  border-bottom: none;
}

.kv-k {
  width: 140rpx;
  font-size: 26rpx;
  color: #6b7280;
  flex-shrink: 0;
}

.kv-v {
  flex: 1;
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  font-size: 26rpx;
  color: #111827;
  word-break: break-all;
  line-height: 1.4;
}

/* ===== tip ===== */
.tip {
  display: flex;
  align-items: flex-start;
  background: #fff8e1;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-top: 20rpx;
}

.tip-icon {
  font-size: 26rpx;
  margin-right: 10rpx;
  line-height: 1.5;
  flex-shrink: 0;
}

.tip-text {
  font-size: 24rpx;
  color: #78350f;
  line-height: 1.5;
  flex: 1;
}

/* ===== fields ===== */
.fields {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.field {
  padding: 18rpx 20rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  border-left: 4rpx solid #4b7bf5;
}

.field.optional {
  border-left-color: #cbd5e1;
  background: #fafbfc;
}

.field-name {
  display: block;
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  font-size: 26rpx;
  color: #111827;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.field-desc {
  display: block;
  font-size: 24rpx;
  color: #4b5563;
  line-height: 1.5;
}

.field-mark {
  display: inline-block;
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  font-size: 22rpx;
  background: #eef2ff;
  color: #4338ca;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin: 0 2rpx;
}

.badge {
  display: inline-block;
  font-size: 20rpx;
  color: #64748b;
  background: #e2e8f0;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-left: 6rpx;
  font-weight: 500;
}

.code-inline {
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  font-size: 24rpx;
  background: #eef2ff;
  color: #4338ca;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

/* ===== code block (sample JSON) ===== */
.code-block {
  position: relative;
  background: #0f172a;
  border-radius: 14rpx;
  padding: 24rpx 22rpx;
  margin-top: 8rpx;
}

.code-block-text {
  display: block;
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  font-size: 22rpx;
  line-height: 1.6;
  color: #e2e8f0;
  white-space: pre;
  word-break: break-all;
}

.copy-btn-abs {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  font-size: 22rpx;
  color: #0f172a;
  background: #f8fafc;
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  font-weight: 500;
}

/* ===== rules ===== */
.rules {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.rule-row {
  display: flex;
  align-items: flex-start;
  font-size: 26rpx;
  line-height: 1.6;
  color: #374151;
}

.rule-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #4b7bf5;
  margin-top: 14rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.rule-text {
  flex: 1;
}

.selectable {
  user-select: text;
  -webkit-user-select: text;
}
