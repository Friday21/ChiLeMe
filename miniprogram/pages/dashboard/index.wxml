<wxs module="utils">
var colors = ['#5BC27E', '#6B6AEB', '#5B8FF9', '#D1D5DB'];
function getColor(index) {
  return colors[index] || colors[0];
}
module.exports.getColor = getColor;
</wxs>
<view class="page-container">
  <!-- Header Section -->
  <view class="header-section">
    <view class="net-worth-info">
      <view class="label-row">
        <text class="label">我的净资产 (CNY)</text>
        <van-icon name="eye-o" size="16px" color="#999" class="ml-2" />
      </view>
      <view class="amount">{{netWorth}}</view>
    </view>
  </view>

  <!-- Asset Cards List -->
  <view class="card-list">
    <block wx:for="{{assetItems}}" wx:key="id">
      <view class="asset-card-container">
        <view class="asset-card" bindtap="toggleExpand" data-id="{{item.id}}">
          <!-- Left Color Bar -->
          <view class="color-bar bar-{{index}}"></view>
          
          <!-- Card Content -->
          <view class="card-content">
            <view class="content-left">
              <view class="card-title">{{item.name}}</view>
              <view class="card-subtitle" wx:if="{{!item.expanded}}">{{item.subtitle}}</view>
              <view class="card-dots" wx:if="{{!item.expanded}}">
                <view class="dot"></view>
                <view class="dot"></view>
                <view class="dot"></view>
              </view>
            </view>
            
            <view class="content-right">
              <view class="amount-row">
                <view wx:if="{{item.isNegative}}" class="negative-icon">
                  <view class="minus-line"></view>
                </view>
                <text class="card-amount {{item.notIncluded ? 'text-gray-400' : ''}}">{{item.amount}}</text>
              </view>
              <view class="text-xs text-gray-400 mt-1 text-right" wx:if="{{item.notIncluded}}">不计入</view>
              <view class="update-date" wx:elif="{{!item.expanded}}">{{item.updateDate}}</view>
            </view>
          </view>
        </view>

        <!-- Expanded Children -->
        <view class="children-list" wx:if="{{item.expanded}}">
          <block wx:for="{{item.children}}" wx:for-item="child" wx:key="name" wx:for-index="childIndex">
            <view class="child-card">
              <view class="child-icon-placeholder">
                <van-icon name="gold-coin" size="24px" color="{{utils.getColor(index)}}" wx:if="{{childIndex === 0}}" />
                <van-icon name="card" size="24px" color="{{utils.getColor(index)}}" wx:else />
              </view>
              <view class="child-content">
                <view class="child-info">
                  <view class="child-name">{{child.name}}</view>
                  <view class="child-subtitle">{{child.subtitle}}</view>
                </view>
                <view class="child-amount-info">
                  <view class="child-amount" style="color: {{utils.getColor(index)}}">{{child.amount}}</view>
                  <view class="child-date">{{child.date}}</view>
                </view>
              </view>
            </view>
          </block>
        </view>
      </view>
    </block>
  </view>

  <!-- Monthly Summary -->
  <view class="monthly-summary">
    <view class="summary-header">
      <text class="summary-title">本月收支</text>
      <text class="summary-balance">结余 {{monthlyBalance}}</text>
    </view>
    
    <view class="progress-container">
      <view class="progress-bg">
        <view class="progress-fill" style="width: {{expenseProgress}}%; background-color: {{expenseProgress > 100 ? '#EE6666' : '#5BC27E'}};"></view>
      </view>
    </view>
    
    <view class="summary-details">
      <view class="detail-item">
        <text class="detail-label">本月支出</text>
        <text class="detail-amount">{{monthlyExpense}}</text>
      </view>
      <view class="detail-item" style="align-items: flex-end;">
        <text class="detail-label">本月收入</text>
        <text class="detail-amount">{{monthlyIncome}}</text>
      </view>
    </view>
  </view>
</view>